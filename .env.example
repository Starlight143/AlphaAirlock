# =====================================================================
# Agentic Alpha Research System — environment template
# Copy to `.env` and fill in the keys for the provider you want to use.
#
# Every flag with cost / external-API implications defaults to OFF. The
# system is fully usable for local demo / development with the bare-minimum
# section (LLM provider) populated; everything else opts in by setting a
# flag to "1" (whitelist parser also accepts "true"/"yes"/"on").
# =====================================================================
# 中文總說明：
#   這是「環境變數範本檔」。請複製成 .env（指令：Windows 用 copy .env.example .env，
#   macOS/Linux 用 cp .env.example .env），再填入你要用的 LLM 供應商金鑰即可。
#   - 所有「會花錢 / 會連外部 API」的開關預設都是關閉(0)，安全第一。
#   - 想開啟某功能，把值設成 1 即可（也接受 true / yes / on；拼錯的值一律當成預設值）。
#   - 最少只要填好「第 1 區：LLM 供應商」，就能在本機 demo / 開發。
#   - 行首有 # 的是「註解」（不會生效）；KEY=VALUE 才是真正的設定。
# =====================================================================

# =====================================================================
# 1) LLM provider (required for any agent work)
# =====================================================================
# 中文：第 1 區｜LLM 供應商（要讓任何 AI agent 運作都必填）。

# Which LLM backend the agents call.
#   anthropic   -> Anthropic native SDK (default)
#   openrouter  -> OpenAI-compatible OpenRouter endpoint
#   minimax     -> MiniMax international (api.minimax.io), OpenAI-compatible,
#                  uses its OWN key (MINIMAX_API_KEY) — never the OpenRouter key
#   auto        -> pick Anthropic if its key exists, else OpenRouter
# 中文：選擇 agent 要呼叫哪一家 LLM。
#   anthropic  = 用 Anthropic 官方 SDK
#   openrouter = 用 OpenRouter（相容 OpenAI 格式，一把金鑰可用多家模型）
#   minimax    = 用 MiniMax 國際版（api.minimax.io，相容 OpenAI 格式，token plan）
#                走自己的金鑰 MINIMAX_API_KEY，完全不會碰到 OpenRouter 金鑰
#   auto       = 有 Anthropic 金鑰就用它，否則改用 OpenRouter
LLM_PROVIDER=minimax

# --- Anthropic native provider --------------------------------------
# Required when LLM_PROVIDER=anthropic (or auto + ANTHROPIC_API_KEY set).
# 中文：用 Anthropic 時必填的金鑰（到 Anthropic 後台申請，sk-ant- 開頭）。
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
# Optional model override. Defaults to claude-3-5-sonnet-latest.
# 中文：可選，指定要用的模型；不填就用預設 claude-3-5-sonnet-latest。
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# --- OpenRouter (OpenAI-compatible) provider ------------------------
# Required when LLM_PROVIDER=openrouter.
# 中文：用 OpenRouter 時必填的金鑰（到 openrouter.ai 申請，sk-or- 開頭）。
OPENROUTER_API_KEY=sk-or--xxxxxxxxxxxxxxxxxxxxxxxx
# Model name on OpenRouter. Examples:
#   anthropic/claude-sonnet-4.6
#   anthropic/claude-3.5-sonnet
#   openai/gpt-4o
#   google/gemini-2.5-pro
# 中文：在 OpenRouter 上要用的模型名稱（上面是範例，可換成你要的）。
OPENROUTER_MODEL=anthropic/claude-sonnet-4.6
# Optional — override the base URL (any OpenAI-compatible endpoint works).
# 中文：可選，改 API 網址；任何相容 OpenAI 格式的端點都可，一般不用動。
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional — sent as HTTP-Referer + X-Title so your account appears in
# OpenRouter's leaderboard. Safe to leave blank.
# 中文：可選，會以 HTTP-Referer / X-Title 送出，讓你的帳號出現在 OpenRouter
#       排行榜上；留空完全沒影響。
OPENROUTER_HTTP_REFERER=
OPENROUTER_X_TITLE=Agentic Alpha Research System

# --- MiniMax (direct international platform, OpenAI-compatible) ------
# Required when LLM_PROVIDER=minimax. This is the MiniMax "token plan" on the
# international site (https://www.minimax.io/platform) — a SEPARATE key from
# OpenRouter. The agents reach it directly, not through OpenRouter.
# 中文：用 MiniMax 國際版（token plan）時必填的金鑰；到 minimax.io 後台申請。
#       這是「直連」MiniMax、跟 OpenRouter 各自獨立的金鑰，不會互相影響。
MINIMAX_API_KEY=your_minimax_api_key_here
# Model name on MiniMax. MiniMax-M3 is the latest flagship (text + vision).
# Other valid ids: MiniMax-M2.5, MiniMax-M2, MiniMax-M2.1, *-highspeed variants.
# 中文：MiniMax 上要用的模型名稱；預設 MiniMax-M3（最新旗艦，支援文字＋視覺）。
MINIMAX_MODEL=MiniMax-M3
# Optional — override the base URL. Default is the international endpoint;
# only change it if MiniMax issues you a different OpenAI-compatible host
# (must stay on https + a *.minimax.io host, enforced by an SSRF guard).
# 中文：可選，覆蓋 API 網址。預設就是國際版端點；一般不用動（限 https + minimax.io）。
MINIMAX_BASE_URL=https://api.minimax.io/v1


# =====================================================================
# 2) Network + database
# =====================================================================
# 中文：第 2 區｜網路與資料庫設定。

# --- Service ports ------------------------------------------------------
# The launchers (start.ps1 / start.sh) treat BACKEND_PORT and FRONTEND_PORT as
# *preferred* ports, NOT hard locks. If a preferred port is already in use, OR
# reserved by the OS, the launcher automatically scans forward for the next
# free port and rewires NEXT_PUBLIC_API_BASE + ALPHA_ALLOWED_ORIGINS to match,
# so the app always comes up even when 3000 / 8000 are taken.
#
# Windows note: Hyper-V / WSL2 / Docker Desktop reserve large dynamic TCP
# ranges (inspect with:  netsh interface ipv4 show excludedportrange protocol=tcp).
# A reserved port fails to bind with EACCES ("permission denied"), NOT the
# usual EADDRINUSE -- common dev ports like 3000 frequently fall inside such a
# reserved range. The auto-select logic transparently handles this case.
#
# Set PORT_AUTO_SELECT=0 to DISABLE auto-selection and instead fail fast when a
# preferred port is unavailable (recommended in production / behind a fixed
# reverse proxy, where the listening port must be deterministic).
# 中文：服務埠號（連接埠）。
#   啟動腳本(start.ps1 / start.sh)把下面的 BACKEND_PORT、FRONTEND_PORT 當成
#   「偏好埠號」而非「鎖死埠號」。若該埠被占用、或被作業系統保留，腳本會自動
#   往後找下一個空閒埠，並同步改寫 NEXT_PUBLIC_API_BASE 與 ALPHA_ALLOWED_ORIGINS，
#   讓前後端永遠對得上、服務一定起得來（就算 3000 / 8000 被占也沒問題）。
#   Windows 特別注意：Hyper-V / WSL2 / Docker Desktop 會「保留」一大段 TCP 埠
#   （查詢指令：netsh interface ipv4 show excludedportrange protocol=tcp）。
#   被保留的埠綁定時會回報 EACCES（權限不足），而不是常見的 EADDRINUSE（被占用），
#   而 3000 這種常用埠很常剛好落在保留區內——自動遞補機制會自動避開、無痛處理。
#   若想關閉自動遞補、埠不可用時就直接報錯停掉，設 PORT_AUTO_SELECT=0
#   （正式環境 / 固定反向代理建議這樣，因為對外埠號必須固定不能浮動）。

# 中文：後端監聽的網卡位址。127.0.0.1=只允許本機連線（最安全）；
#       0.0.0.0=同網段其他電腦也能連進來。
BACKEND_HOST=127.0.0.1
# 中文：後端「偏好」埠號（非鎖死）。被占用或被系統保留時會自動換下一個空閒埠。
BACKEND_PORT=8000
# 中文：前端監聽位址。預設 0.0.0.0（同網段他人也能開）；只想自己本機開就改 127.0.0.1。
FRONTEND_HOST=0.0.0.0
# 中文：前端「偏好」埠號（非鎖死），同樣會自動遞補。
FRONTEND_PORT=3000
# 中文：埠號自動遞補開關。1=被占用就自動找下一個空的（開發推薦）；
#       0=埠不能用就直接報錯停掉（正式 / 固定反向代理推薦，埠號需固定）。
PORT_AUTO_SELECT=1

# Browser-facing URL of the FastAPI backend. NEXT_PUBLIC_* is inlined into the
# frontend JS bundle at BUILD time. The dev launchers OVERRIDE this at runtime
# with the actually-selected backend port, so you normally leave it as-is. Set
# it manually only for production frontend builds, or when you start the
# frontend WITHOUT start.ps1 / start.sh.
# 中文：前端要呼叫的後端網址。NEXT_PUBLIC_ 開頭的變數會在「打包前端」時就被寫死
#       進 JS。用 start 腳本啟動時，腳本會在執行階段自動用「實際選到的後端埠」
#       覆蓋它，所以平常保持預設即可。只有在「正式打包前端」或「不透過 start 腳本
#       啟動前端」時，才需要手動設成正確的後端網址。
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000

# Optional — override the SQLite default. Any SQLAlchemy URL works
# (e.g. ``postgresql+psycopg2://user:pw@host/db``). SQLite-specific
# pragmas (WAL, busy_timeout, synchronous) only apply when the URL
# starts with "sqlite".
# 中文：可選，覆蓋預設的 SQLite 資料庫。可填任何 SQLAlchemy 連線字串
#       （例如 PostgreSQL：postgresql+psycopg2://帳號:密碼@主機/資料庫）。
#       WAL、busy_timeout、synchronous 等 SQLite 專屬設定只有在網址以 sqlite
#       開頭時才會套用。預設用專案內的 SQLite 檔，想用就把下一行的 # 拿掉。
# ALPHA_DATABASE_URL=sqlite:///./backend/data/alpha_system.db

# Auto-create schema on import (P15/D-M2). Default ON for backward
# compatibility — first import of backend.core.database calls init_db().
# Set to 0 when managing schema externally (Alembic, manual SQL, restore
# from snapshot, multi-process boot where only one worker should init).
# 中文：啟動時自動建立資料表。預設 1（開，相容舊版）——第一次載入資料庫模組時
#       會自動建表。若你用 Alembic 遷移 / 手動 SQL / 還原備份 / 多行程啟動只想
#       讓其中一個 worker 建表，就設 0。
ALPHA_AUTO_INIT_DB=1


# =====================================================================
# 3) LLM daily USD budget cap (P6 cross-cutting cost guard)
# =====================================================================
# Default 0.0 = disabled (no cap). Set to a positive USD number to enable.
# Estimation uses Sonnet pricing assumptions by default; calls that would
# push the running daily total past the cap raise LLMBudgetExceededError,
# which the orchestrator catches and converts to REJECTED+reason="budget".
# 中文：第 3 區｜LLM 每日花費上限（美元），全系統共用的成本防護。
#       預設 0.0=不限制。設成正數即啟用：當「預估當日累計花費」會超過上限時，
#       會丟出 LLMBudgetExceededError，orchestrator 會接住並把該次標成
#       REJECTED（原因 budget）。預估預設用 Sonnet 的價格假設。
# 中文：每日花費上限金額（美元）。0=關閉不限制；例如 5.0 代表一天最多花 5 美元。
ALPHA_LLM_DAILY_USD_CAP=0.0
# 中文：估算用——每百萬「輸入」token 的價格（美元）。
ALPHA_LLM_INPUT_PRICE_PER_1M=3.0
# 中文：估算用——每百萬「輸出」token 的價格（美元）。
ALPHA_LLM_OUTPUT_PRICE_PER_1M=15.0
# 中文：估算用——「幾個字元算 1 個 token」的換算係數，預設 3.5。
ALPHA_LLM_CHARS_PER_TOKEN=3.5


# =====================================================================
# 4) Ingestion scheduler (P3 — was undocumented prior to P6)
# =====================================================================
# Master switch for the source-polling loop. Off by default.
# 中文：第 4 區｜資料來源輪詢排程器（自動定時去各來源抓資料）。
# 中文：總開關。1=開啟自動輪詢來源。
ALPHA_INGEST_ENABLED=1
# Tick interval in seconds, clamped to >=5.
# 中文：每隔幾秒輪詢一次，最小 5 秒（小於 5 會被自動拉到 5）。
ALPHA_INGEST_TICK_SECONDS=30


# =====================================================================
# 5) Telegram outbound + automatic reports (P3c + P6-B6)
# =====================================================================
# Outbound master switch. Required for any send (transitions, errors,
# six-hour pulse, morning briefing, paper-health digest).
# 中文：第 5 區｜Telegram「主動發送」訊息 + 自動報告。
#       對外發送總開關。要發任何訊息（狀態變化、錯誤、每 6 小時脈動、早報、
#       紙上交易健康摘要）都得先把這個開起來。
# 中文：1=開啟對外發送。
TELEGRAM_ENABLED=0
# 中文：你的 Telegram bot token（向 Telegram 的 @BotFather 申請）。
TELEGRAM_BOT_TOKEN=
# 中文：要把訊息發到哪個聊天室 / 使用者的 chat ID。
TELEGRAM_CHAT_ID=

# Automatic report emitters (each requires TELEGRAM_ENABLED=1 first).
# 中文：各種自動報告開關（每個都要先 TELEGRAM_ENABLED=1 才有效）。
# 中文：每 6 小時脈動報告。1=開。
TG_SIX_HOUR_ENABLED=0
# 中文：每日早報。1=開。
TG_MORNING_ENABLED=0
# 中文：紙上交易健康摘要。1=開。
TG_PAPER_HEALTH_ENABLED=0
# UTC hour to fire the morning briefing. Default 1 = 09:00 GMT+8 Asia.
# 中文：早報要在 UTC 幾點發送。預設 1 = 台灣 / 北京時間（GMT+8）早上 9 點。
TG_MORNING_HOUR_UTC=1


# =====================================================================
# 6) Telegram inbound /intake bot (P5-BE-06)
# =====================================================================
# Inbound bot is GATED INDEPENDENTLY from outbound so a deployment that
# only wants notifications can't have arbitrary intake calls triggered
# by anyone-with-the-token.
# 中文：第 6 區｜Telegram「接收指令」/intake 機器人。
#       這個跟「對外發送」是分開控制的——這樣只想收通知的部署，不會被任何
#       拿到 token 的人亂下 /intake 指令灌資料。
# 中文：1=開啟接收指令。
TELEGRAM_INBOUND_ENABLED=0
# Comma-separated allowlist; falls back to TELEGRAM_CHAT_ID when unset.
# 中文：允許下指令的聊天室白名單（逗號分隔）；留空就退回用 TELEGRAM_CHAT_ID。
TELEGRAM_ALLOWED_CHAT_IDS=


# =====================================================================
# 6b) Discord inbound /intake bot (P8-FIX/C-5)
# =====================================================================
# Same shape as the Telegram inbound bot — a long-running discord.py
# gateway client that listens for `/intake <text>` (or replies to a
# message with `/intake`) in any allow-listed channel and writes the
# resulting KnowledgeNode with source_type='discord_intake'.
#
# Hard requirements before the bot starts:
#   1. DISCORD_INBOUND_ENABLED=1
#   2. DISCORD_BOT_TOKEN  — a real bot token from
#      https://discord.com/developers/applications (must enable the
#      "Message Content Intent" toggle on that page; it's privileged)
#   3. DISCORD_ALLOWED_CHANNEL_IDS — at least one int channel ID
#
# Missing any of the three → bot stays off, no errors, no traffic.
# 中文：第 6b 區｜Discord 版「接收指令」/intake 機器人，跟 Telegram 那個一樣。
#       它是常駐的 discord.py 連線客戶端，在白名單頻道裡輸入 /intake <文字>
#       （或對某則訊息回覆 /intake）就會寫入一筆知識節點(source_type=discord_intake)。
#       啟動前三個條件缺一不可：
#         1. DISCORD_INBOUND_ENABLED=1
#         2. DISCORD_BOT_TOKEN（真實 bot token，且要在 Discord 開發者後台打開
#            「Message Content Intent」這個特權開關）
#         3. DISCORD_ALLOWED_CHANNEL_IDS（至少一個頻道 ID）
#       三者缺任何一個 → bot 不啟動，不報錯、也不產生任何流量。
# 中文：1=開啟。
DISCORD_INBOUND_ENABLED=0
# 中文：Discord 開發者後台的 bot token。
DISCORD_BOT_TOKEN=
# Comma-separated integer channel IDs (right-click channel -> Copy ID
# in Discord Developer Mode). Bot ignores messages from any other
# channel. Per-channel rate limit is 1 intake / 10 s.
# 中文：允許的頻道 ID 白名單（逗號分隔的整數；在 Discord 開「開發者模式」後，
#       右鍵頻道→複製 ID）。bot 會忽略其他頻道的訊息。每個頻道限流為 10 秒 1 次。
DISCORD_ALLOWED_CHANNEL_IDS=


# =====================================================================
# 7) Auto-pipeline from ingest (P6-B1)
# =====================================================================
# When a new KnowledgeNode lands, optionally fire a full pipeline run on
# it. Quintuple-gated: env flag + per-source daily quota + IC threshold
# + batch cap + process-level concurrency semaphore.
# 中文：第 7 區｜新資料進來時自動跑完整 pipeline。
#       有新知識節點寫入時，可選擇自動對它跑一次完整流程。五重關卡保護：
#       總開關 + 每來源每日配額 + IC 門檻 + 批次上限 + 行程層級並行數限制。
# 中文：1=開啟「新資料自動跑 pipeline」。
AUTO_PIPELINE_FROM_INGEST=0
# 中文：IC（資訊係數，衡量訊號品質）要 ≥ 這個值才會自動跑。
AUTO_PIPELINE_IC_THRESHOLD=0.6
# 中文：每個來源每天最多自動跑幾次（防某來源洗版狂花錢）。
AUTO_PIPELINE_MAX_PER_SOURCE_PER_DAY=3
# 中文：每批一次處理幾筆。
AUTO_PIPELINE_BATCH_SIZE=1
# 中文：同時最多幾個自動 pipeline 在跑。
AUTO_PIPELINE_CONCURRENCY=1

# Separately gate the *intake bot* path (Telegram /intake + Discord
# /intake) so a normal /api/intake POST stays auto-pipelined while bot
# traffic doesn't fire LLM-spending pipeline runs without explicit
# operator opt-in. Default OFF to prevent surprise costs in existing
# deployments. Read in core/telegram_inbound.py + core/discord_inbound.py.
# 中文：單獨控制「bot 收到的 /intake」要不要也觸發自動 pipeline。這樣一般的
#       /api/intake POST 仍會自動跑，但 bot 流量不會在你沒同意下偷花 LLM 的錢。
#       預設關，避免既有部署被意外加錢。
AUTO_PIPELINE_FROM_INTAKE_BOTS=0


# =====================================================================
# 8) IC-priority alpha queue (P6-B2)
# =====================================================================
# Scheduled tick that promotes top-N high-IC nodes through the pipeline
# even without new ingest. Manual /api/alpha-queue/promote/{id} always
# works regardless of this flag — only the scheduled tick is gated.
# 中文：第 8 區｜IC 優先佇列。
#       定時把「IC 最高的前 N 筆」節點推進 pipeline，就算沒有新資料進來也會跑。
#       手動推進 API（/api/alpha-queue/promote/{id}）永遠可用、不受此開關影響，
#       只有「定時自動推進」會被它控制。
# 中文：1=開啟定時自動推進。
ALPHA_QUEUE_ENABLED=0
# 中文：IC 要 ≥ 這個值才會被排進佇列。
ALPHA_QUEUE_IC_FLOOR=0.5
# 中文：每次推進幾筆。
ALPHA_QUEUE_BATCH_SIZE=1


# =====================================================================
# 9) KB cross-linking + IC decay (P6-B3)
# =====================================================================
# Nightly batch: TF-IDF cosine recompute of node-to-node `links`.
# 中文：第 9 區｜知識庫交叉連結 + IC 衰減。
#       每晚批次工作：用 TF-IDF 餘弦相似度重新計算「節點與節點之間的關聯連結」。
# 中文：1=開啟每晚自動重算節點關聯。
KB_NIGHTLY_ENABLED=1
# 中文：相似度要 ≥ 這個值才建立連結（越高越嚴格，連得越少但越精準）。
KB_RELINK_THRESHOLD=0.30
# 中文：每個節點最多連結幾個最相似的對象。
KB_RELINK_TOP_K=5
# Most-recent N nodes the index covers. Larger = better recall, more memory.
# 中文：索引涵蓋「最近 N 筆」節點。越大召回越好，但越吃記憶體。
KB_RELINK_CORPUS_SIZE=2000
# `word` (English space-tokenised) or `char_wb` (char n-grams, CJK-friendly).
# 中文：斷詞方式。word=用空白斷詞（適合英文）；char_wb=字元 n-gram
#       （對中文 / 日文 / 韓文這類沒有空白的語言較友善）。
KB_RELINK_ANALYZER=word
# 中文：只重新連結「最近幾小時」內的節點。
KB_RELINK_RECENT_HOURS=24
# 中文：每晚最多處理幾個節點（控制夜間批次工作量）。
KB_RELINK_NIGHTLY_LIMIT=50

# IC decay knobs (separate flag because operators may want one without
# the other).
# 中文：IC 衰減旋鈕（獨立開關，因為有人可能只想要其中一個功能）。
#       IC 衰減＝讓舊的 IC 分數隨時間慢慢變小，避免老訊號一直占高分。
# 中文：1=開啟 IC 衰減。
IC_DECAY_ENABLED=1
# 中文：半衰期幾天（經過幾天，IC 的影響力減半）。
KB_IC_HALF_LIFE_DAYS=30
# 中文：IC 衰減的下限，分數再怎麼衰減都不會低於這個值。
KB_IC_FLOOR=0.05


# =====================================================================
# 10) Source fetchers (P6-B4)
# =====================================================================
# 中文：第 10 區｜各類來源抓取器。
# Append the YouTube auto-captions to each video's KnowledgeNode body.
# Off by default — adds an extra HTTP request per video.
# 中文：把 YouTube 的自動字幕，接到每支影片的知識節點內文裡。預設關，因為每支
#       影片都要多打一次 HTTP 請求。1=開。
YT_TRANSCRIPT_ENABLED=0
# arXiv result cap per polled query. arXiv asks for ~3s delay between
# queries — the pip pkg's Client honours that automatically.
# 中文：每次查詢 arXiv 最多抓幾筆結果。arXiv 要求查詢間隔約 3 秒，套件的
#       Client 會自動遵守，不用你處理。
ARXIV_MAX_RESULTS=10
# Nitter mirror for the Twitter fetcher. Public instances rotate; override
# if the default starts 502'ing.
# 中文：抓 Twitter 用的 Nitter 鏡像站網址。公開站點常常輪替 / 失效，若預設站
#       開始回 502，就換一個可用的鏡像站填進來。
NITTER_INSTANCE_URL=https://nitter.privacydev.net


# =====================================================================
# 11) Granger causality edges (P6-B5)
# =====================================================================
# Per-pair p-value computation over ic_history time series.
# 中文：第 11 區｜Granger 因果關係邊。
#       對 ic_history（IC 歷史）時間序列，做兩兩之間的 Granger 因果檢定（算 p 值），
#       用來判斷「A 的變化是否有助於預測 B」。
# 中文：1=開啟。
GRANGER_ENABLED=1
# Only consider pairs where both endpoints have ic_score >= this.
# 中文：只考慮「兩端的 ic_score 都 ≥ 這個值」的配對。
GRANGER_IC_FLOOR=0.3
# O(N²) cap — at 50 we evaluate ~50 directed pair-lag combinations.
# 中文：配對數上限。計算量是 O(N²)，設 50 約等於評估 ~50 組「有向配對-落後期」組合。
GRANGER_MAX_PAIRS=50
# 中文：最大落後期數（檢定時往前看幾期）。
GRANGER_MAX_LAG=1


# =====================================================================
# 12) Asset (image) cache (P6-B7)
# =====================================================================
# Cache inline <img> tags from feed items into storage/assets/ so the
# KB Explorer renders "圖文並茂" content.
# 中文：第 12 區｜圖片資產快取。
#       把 feed 內文裡的 <img> 圖片，快取到 storage/assets/，讓 KB Explorer
#       能呈現圖文並茂的內容。
# 中文：1=開啟圖片快取。
ASSET_CACHE_ENABLED=0
# Per-image hard cap (5 MB default).
# 中文：單張圖片大小硬上限（位元組，預設 5242880=5MB）。
ASSET_CACHE_MAX_BYTES_PER_IMAGE=5242880
# httpx connect+read timeout.
# 中文：抓圖的連線+讀取逾時秒數。
ASSET_CACHE_TIMEOUT_SECONDS=10
# Hard cap so a single feed item with 100 inline images can't fill disk.
# 中文：單篇最多快取幾張圖（避免一篇塞 100 張圖把硬碟灌爆）。
ASSET_CACHE_MAX_IMAGES_PER_ITEM=8


# =====================================================================
# 13) Paper-trade auto-tick (P6-M12)
# =====================================================================
# Re-runs paper_trade for every APPROVED/PAPER_TRADE/SMALL_CAPITAL/LIVE
# strategy on a cadence. The driver's interval is `paper_trade_tick`
# in periodic_tasks.py (default 30s); this extra knob prevents the same
# strategy from being re-simulated more than once per N seconds.
# P17/C-M10 — default flipped to 1; set to 0 in CI/dev for deterministic snapshots
# 中文：第 13 區｜紙上交易自動 tick（定時重跑模擬）。
#       對每個 APPROVED / PAPER_TRADE / SMALL_CAPITAL / LIVE 狀態的策略，定時
#       重跑一次紙上交易。驅動頻率是 periodic_tasks.py 裡的 paper_trade_tick
#       （預設 30 秒）；下面這個額外旋鈕用來防止「同一策略」在 N 秒內被重複模擬。
# 中文：1=開啟定時重跑（預設）。在 CI / 開發想要可重現的固定快照時設 0。
ALPHA_PAPER_TICK_ENABLED=1
# 中文：同一策略最快每幾秒才會被重算一次。
PAPER_TRADE_MIN_REFRESH_SECONDS=60
# 中文：紙上交易回看天數（用多久的歷史資料模擬）。
PAPER_TRADE_WINDOW_DAYS=30


# =====================================================================
# 14) Semantic retrieval (P6-D04)
# =====================================================================
# Controls the *automatic* use of TF-IDF semantic retrieval inside the
# orchestrator's auto-pipeline path. The explicit endpoint
# POST /api/knowledge/semantic-search always works regardless — it's a
# manual operator action with no recurring cost.
# 中文：第 14 區｜語意檢索。
#       控制 orchestrator 自動 pipeline 路徑「自動」使用 TF-IDF 語意檢索。
#       手動的語意搜尋 API（POST /api/knowledge/semantic-search）永遠可用、
#       不受此開關影響——那是人為操作、沒有重複性成本。
# 中文：1=開啟「自動」語意檢索。
SEMANTIC_RETRIEVAL_ENABLED=1
# 中文：索引最多納入幾個節點。
SEMANTIC_RETRIEVAL_MAX_NODES=5000
# Rebuild the index when node count drifts > N% from build-time count.
# 中文：當「目前節點數」比「建索引當時」漂移超過 N% 時，就重建索引。
SEMANTIC_RETRIEVAL_REBUILD_PCT=10.0
# OR when the index is older than this many seconds (default 1 h).
# 中文：或者，索引超過這麼多秒就重建（預設 3600 秒=1 小時）。
SEMANTIC_RETRIEVAL_REBUILD_AGE=3600
# Score boosts for soft-matching beyond raw cosine similarity.
# 中文：除了純餘弦相似度之外的加分（軟性比對）：
# 中文：命中「相同分類」時的加分。
SEMANTIC_RETRIEVAL_CATEGORY_BOOST=0.15
# 中文：命中「相同標籤」時的加分。
SEMANTIC_RETRIEVAL_TAG_BOOST=0.05
# Max n-gram width for the TF-IDF vectoriser (1=unigrams only, 2=add bigrams).
# 中文：TF-IDF 最大 n-gram 寬度（1=只看單詞；2=連雙詞一起看，較精準但較耗資源）。
SEMANTIC_RETRIEVAL_NGRAM_MAX=2


# =====================================================================
# 14b) Graph RAG — graph-aware retrieval (upgrade of P6-D04)
# =====================================================================
# Replaces flat TF-IDF cosine scan with a two-phase pipeline:
#   Phase 1 — TF-IDF anchor finding (reuses the existing index cache)
#   Phase 2 — Weighted BFS over granger_edges + node.links
#
# Default ON because networkx is already in requirements.txt and the
# graph degrades gracefully when granger_edges / node.links are empty
# (Phase 2 returns only anchor hits → same behaviour as plain TF-IDF).
# Set to 0 to force the legacy flat TF-IDF scan on every search call.
# 中文：第 14b 區｜Graph RAG（具圖結構意識的檢索，是 14 區的升級版）。
#       把原本「平面 TF-IDF 餘弦掃描」改成兩階段：
#         階段 1 — 用 TF-IDF 找錨點（沿用既有索引快取）
#         階段 2 — 沿著 granger 因果邊 + 節點連結，做加權廣度優先搜尋(BFS)
#       預設開，因為 networkx 已在 requirements.txt 內；而且當因果邊 / 節點連結
#       都是空的時候，會自動退化成「只回錨點」＝跟純 TF-IDF 行為一樣，很安全。
# 中文：1=開啟圖檢索；0=強制每次搜尋都用舊的平面 TF-IDF。
GRAPH_RAG_ENABLED=1

# Max Granger edge p-value to include in the graph. Edges with p >= this
# threshold are excluded (too weak to be statistically useful).
# 中文：納入圖中的 Granger 邊，其 p 值要「小於」這個門檻；p ≥ 這個值的邊會被
#       排除（統計上太弱、沒參考價值）。
GRAPH_RAG_P_THRESHOLD=0.10

# Maximum BFS hops from anchor nodes. 2 covers anchor → 1-hop causal
# effect → 2-hop downstream effect. Raise to 3 for deeper traversal
# (exponentially more nodes explored per query).
# 中文：從錨點最多走幾「跳」。2=錨點→1 跳因果影響→2 跳下游影響。調到 3 會走更深，
#       但每次查詢要探索的節點數呈指數成長。
GRAPH_RAG_MAX_HOPS=2

# Number of TF-IDF anchor nodes used as BFS starting points.
# Lower = faster, higher = broader coverage. 3 is sufficient for most
# alpha queries; raise to 5 for wide-topic research questions.
# 中文：用幾個 TF-IDF 錨點當 BFS 起點。越少越快，越多覆蓋越廣。一般查詢 3 個就夠；
#       主題很廣的研究問題可調到 5。
GRAPH_RAG_ANCHOR_K=3

# Hard cap on nodes explored per query. Prevents runaway traversal on
# dense graphs. Nodes beyond the budget are never scored or returned.
# 中文：每次查詢最多探索幾個節點的硬上限，防止在密集圖上「爆走」。超出預算的
#       節點不會被計分、也不會被回傳。
GRAPH_RAG_EXPAND_BUDGET=80

# Graph cache TTL in seconds (default 30 min). The cache is also
# invalidated immediately when kb_relink writes new node.links edges.
# 中文：圖快取存活秒數（預設 1800=30 分鐘）。另外，當 kb_relink 寫入新的節點
#       連結時，快取會立刻失效重建。
GRAPH_RAG_CACHE_TTL=1800

# Trigger a full graph rebuild when the KnowledgeNode count drifts by
# more than this percentage from the count at last build time.
# 中文：當知識節點數量比「上次建圖時」漂移超過這個百分比，就整個重建圖。
GRAPH_RAG_REBUILD_PCT=5.0


# =====================================================================
# 14c) Article Enricher — full-text extraction for RSS teasers (P6-D05)
# =====================================================================
# When enabled, after an RSS poll each item whose body is shorter than
# ARTICLE_ENRICH_MIN_BODY chars is fetched again via its article URL.
# Strategy cascade per domain:
#   1. Direct fetch with Googlebot UA (wsj.com, ft.com, barrons.com …)
#      or Google Referer (bloomberg.com, nytimes.com …)
#   2. Domain-specific proxy: Medium domains → freedium.cfd
#      All others             → 12ft.io/proxy
#
# IMPORTANT: bypassing publisher paywalls may violate their Terms of Service.
# Enable only for content you are entitled to access.
#
# Requires: trafilatura>=1.9.0  (already in requirements.txt).
# 中文：第 14c 區｜文章全文補抓（把 RSS 的「摘要」補成「全文」）。
#       開啟後，每次 RSS 輪詢完，凡是內文短於 ARTICLE_ENRICH_MIN_BODY 字元的項目，
#       會用它的文章網址再抓一次全文。各網域的策略順序：
#         1. 直接抓（對 wsj/ft/barrons 用 Googlebot UA；對 bloomberg/nytimes 帶 Google Referer）
#         2. 網域專用代理：Medium 類 → freedium.cfd；其餘 → 12ft.io/proxy
#       重要：繞過出版商付費牆可能違反對方服務條款，請「只對你有權存取的內容」開啟。
#       需要套件：trafilatura>=1.9.0（已列在 requirements.txt）。
# 中文：總開關。1=開啟全文補抓。
ARTICLE_ENRICH_ENABLED=0

# Only attempt enrichment for items whose current body is shorter than N chars.
# Default 500 — a typical RSS teaser is 100-300 chars.
# 中文：只有「目前內文短於 N 字元」的項目才會去補抓。預設 500（一般 RSS 摘要約 100-300 字元）。
ARTICLE_ENRICH_MIN_BODY=500

# Maximum number of items to enrich per RSS poll call.
# Each enriched item costs 1-2 extra HTTP requests; keep low to avoid
# making a single poll take tens of seconds.
# 中文：每次 RSS 輪詢最多補抓幾篇。每篇要多打 1-2 次 HTTP，設低一點避免單次
#       輪詢拖到數十秒。
ARTICLE_ENRICH_MAX_ITEMS=5

# Per-request HTTP timeout in seconds for enrichment fetches.
# 中文：每次補抓的 HTTP 逾時秒數。
ARTICLE_ENRICH_TIMEOUT=15

# Medium proxy base URL.  freedium.cfd is a community mirror;
# replace with your own instance if needed.
# 中文：Medium 文章用的代理站網址。freedium.cfd 是社群鏡像；需要的話可換成你自己的。
ARTICLE_ENRICH_FREEDIUM_URL=https://freedium.cfd

# Generic paywall proxy base URL.  Used as fallback for non-Medium sites.
# 中文：通用付費牆代理站網址，用於非 Medium 網站的後備方案。
ARTICLE_ENRICH_12FT_URL=https://12ft.io


# =====================================================================
# 15) P7 — Backtest Lab (parameter sweep runner)
# =====================================================================
# Master switch for /backtest-lab page + its 5 endpoints. Off by default
# because a single sweep can launch up to BACKTEST_LAB_MAX_CELLS backtests
# in parallel. Routes return 503 when disabled.
# 中文：第 15 區｜回測實驗室（參數掃描執行器）。
#       /backtest-lab 頁面與其 5 個 API 的總開關。預設關，因為一次掃描最多會
#       「同時」跑 BACKTEST_LAB_MAX_CELLS 個回測。關閉時這些路由會回 503。
# 中文：1=開啟回測實驗室。
BACKTEST_LAB_ENABLED=1
# Max cells per sweep grid (5x5 = 25 is the sane default). To raise above
# 25 set BACKTEST_LAB_ALLOW_LARGE=1 (then cap becomes 100).
# 中文：每次掃描網格最多幾格（5x5=25 是合理預設）。要超過 25，得把下面的
#       BACKTEST_LAB_ALLOW_LARGE 設成 1（上限就提高到 100）。
BACKTEST_LAB_MAX_CELLS=25
# 中文：1=允許大網格（上限提高到 100）；0=維持 25 上限。
BACKTEST_LAB_ALLOW_LARGE=0
# Worker pool size (max 4). Each worker runs one backtest cell at a time.
# 中文：工作執行緒數（最多 4）。每個 worker 一次跑一格回測。
BACKTEST_LAB_WORKERS=2


# =====================================================================
# 16) P7 — Factor Studio (sandboxed factor formula editor)
# =====================================================================
# Default ON — eval runs in the existing sandbox.py with AST whitelist +
# 8s watchdog. Set to 0 to hide the page + return 503 from endpoints.
# 中文：第 16 區｜因子工作室（沙箱化的因子公式編輯器）。
#       預設開——公式運算在 sandbox.py 沙箱內執行（AST 白名單 + 8 秒看門狗，
#       防止惡意 / 失控程式碼）。設 0 會隱藏頁面，且 API 回 503。
# 中文：1=開啟（預設）。
FACTOR_STUDIO_ENABLED=1
# Per-IP rate limit on /evaluate (the only expensive route).
# 中文：/evaluate（唯一耗資源的路由）每個 IP 每分鐘限幾次。
FACTOR_STUDIO_EVAL_RATE_PER_MIN=10


# =====================================================================
# 17) P7 — Live Trade dashboard (read-only paper-mirror)
# =====================================================================
# Gate exchange routing. With 0 (default), /live-trade renders the paper
# trade mirror; all order paths refuse to call exchange_adapter. With 1,
# the page UI exposes a LIVE mode toggle (still safe — actual live order
# placement raises NotImplementedError until M14 ships).
# 中文：第 17 區｜實盤交易儀表板（唯讀的紙上交易鏡像）。
#       控制「是否路由到真實交易所」。0（預設）=/live-trade 只顯示紙上交易鏡像，
#       所有下單路徑都拒絕呼叫交易所介面卡。1=UI 會出現 LIVE 模式切換鈕（仍安全——
#       在 M14 上線前，真正的實盤下單會丟 NotImplementedError）。
# 中文：1=開啟 LIVE 模式 UI。
LIVE_TRADE_ENABLED=0
# 中文：計價基準幣別（預設 USDT）。
LIVE_TRADE_BASE_CCY=USDT
# Idempotency cache window for pause-all (seconds).
# 中文：「全部暫停」操作的冪等快取視窗（秒）——同一動作在此時間內重複送只算一次。
LIVE_TRADE_PAUSE_IDEM_TTL=60


# =====================================================================
# 18) P7 — Trading Terminal (manual order entry)
# =====================================================================
# Master switch — independent from LIVE_TRADE_ENABLED so deployments can
# expose the page in PAPER-only mode without enabling live routing.
# 中文：第 18 區｜交易終端機（手動下單）。
#       總開關——跟 LIVE_TRADE_ENABLED 分開，這樣可以只開「純紙上模式」頁面，
#       而不啟用任何真實路由。
# 中文：1=開啟下單終端機。
TRADING_TERMINAL_ENABLED=0
# 中文：每分鐘下單次數上限。
TRADING_TERMINAL_RATE_LIMIT_PER_MIN=30
# Fat-finger protection — reject orders priced beyond this fraction of last.
# P29-T7: default tightened 0.20 -> 0.03 (3%). Set explicitly above 0.03 if
# your deployment legitimately needs the looser cap. Also accepts the
# new name TRADING_FAT_FINGER_PCT (see section 22 below) for symmetry
# with the other risk caps; whichever is set last in the env wins.
# 中文：防手殘保護——下單價格偏離「最新價」超過這個比例就拒絕。預設已收緊到
#       0.03（3%）。若你的部署確實需要較寬鬆的上限，再明確設成大於 0.03。
#       它也接受新名字 TRADING_FAT_FINGER_PCT（見第 22 區），用來和其他風險上限
#       擺在一起；兩者誰在環境中最後被設定，誰就生效。
TRADING_TERMINAL_FAT_FINGER_PCT=0.03
# Paper fee model (bps, 10 = 0.10%). Maker for limit fills, taker for
# market/stop.
# 中文：紙上交易手續費模型（單位 bps，10=0.10%）。限價成交用 maker 費率，
#       市價 / 停損成交用 taker 費率。
TRADING_TERMINAL_MAKER_BPS=10
TRADING_TERMINAL_TAKER_BPS=10
# 中文：紙上交易的預設起始資金（USDT）。
TRADING_TERMINAL_DEFAULT_CASH_USDT=100000


# =====================================================================
# 19) P7 — Idempotency middleware (shared by high-risk endpoints)
# =====================================================================
# How long an Idempotency-Key row is kept before the nightly purge can
# delete it. Replay window — within this TTL, same key + same body returns
# cached response; same key + different body returns 409.
# 中文：第 19 區｜冪等性中介層（高風險 API 共用）。
#       一筆 Idempotency-Key 紀錄保留多久後，才會被夜間清除任務刪掉。這是「重放
#       視窗」：在此時間內，相同 key + 相同 body 會回傳快取結果；相同 key + 不同
#       body 會回 409（避免重複下單 / 重複扣款）。
# 中文：冪等鍵保留小時數（重放視窗長度）。
IDEMPOTENCY_TTL_HOURS=24


# =====================================================================
# 19b) Agent dialogue turn history GC (P16)
# =====================================================================
# Max age of stored agent dialogue turns before the periodic GC sweep
# evicts them. Larger = longer replay window in the Mission Control
# stream; smaller = lower DB footprint. Clamped to 1..720 hours.
# 中文：第 19b 區｜agent 對話輪次歷史的垃圾回收(GC)。
#       已儲存的 agent 對話輪次，在被定期 GC 清掉前最多保留多久。越大→Mission
#       Control 串流可回放越久；越小→資料庫越省空間。範圍限制在 1~720 小時。
AGENT_DIALOGUE_GC_MAX_AGE_HOURS=72


# =====================================================================
# 20) P7 — Market regime classifier (used by IR Explorer)
# =====================================================================
# Lookback period (days) for BTC trend classification.
# 中文：第 20 區｜市場狀態分類器（IR Explorer 使用）。
#       用來判斷目前是牛市 / 熊市 / 盤整。
# 中文：BTC 趨勢分類的回看天數。
REGIME_LOOKBACK_DAYS=30
# BTC return above this in the lookback window → bull regime.
# 中文：回看區間內，BTC 報酬「高於」這個值 → 判定為牛市（預設 0.05=漲超過 5%）。
REGIME_BULL_PCT=0.05
# BTC return below this → bear regime. (Negative number.)
# 中文：BTC 報酬「低於」這個值 → 判定為熊市（要填負數，預設 -0.05=跌超過 5%）。
REGIME_BEAR_PCT=-0.05


# =====================================================================
# 22) P29 — additional safety / security knobs (added by P29 audit cycle)
# =====================================================================
# All entries here default to safe-by-default (CORS pinned to localhost,
# SSRF guard ON, trade caps capped at sensible numbers). Production
# deployments should review and adjust per their environment.
# 中文：第 22 區｜P29 稽核新增的安全 / 防護旋鈕。
#       這一區全部「預設即安全」（CORS 鎖本機、SSRF 防護開啟、交易上限設在合理值）。
#       正式部署請務必依你的實際環境檢視並調整。

# --- 22a) CORS allowlist -------------------------------------------------
# Comma-separated list of fully-qualified origin URLs that the FastAPI
# backend will accept (Access-Control-Allow-Origin). Empty / unset falls
# back to the localhost dev defaults (http://localhost:3000 +
# http://127.0.0.1:3000). REQUIRED in production — set this to the
# exact deployed frontend URL(s); do NOT leave on the localhost default
# when the API is reachable from outside the host.
#   Example single origin:  ALPHA_ALLOWED_ORIGINS=https://alpha.example.com
#   Example multi-origin:   ALPHA_ALLOWED_ORIGINS=https://alpha.example.com,https://staging.alpha.example.com
# 中文：22a) CORS 來源白名單。
#       後端會接受的「前端來源網址」清單（逗號分隔，要完整 URL）。留空 / 不設時，
#       退回本機開發預設（http://localhost:3000 與 http://127.0.0.1:3000）。
#       正式環境必填：設成你實際部署的前端網址；當 API 會被主機外部存取時，
#       千萬不要留著 localhost 預設值。
#       （注意：用 start 腳本啟動時，腳本會自動把「實際選到的前端埠」加進來。）
#         單一來源範例：ALPHA_ALLOWED_ORIGINS=https://alpha.example.com
#         多來源範例：  ALPHA_ALLOWED_ORIGINS=https://alpha.example.com,https://staging.alpha.example.com
ALPHA_ALLOWED_ORIGINS=

# --- 22b) Ingest SSRF escape hatch --------------------------------------
# By default, POST /api/sources rejects URLs whose hostname resolves to a
# RFC1918 / loopback / link-local / multicast / reserved IP — this is the
# SSRF guard that prevents an operator (or attacker) from pointing a feed
# at http://169.254.169.254/ (AWS metadata), http://127.0.0.1:8000/admin,
# or internal-only services. Set to 1/true/yes ONLY in trusted local dev
# where you intentionally want to ingest from localhost. NEVER enable in
# production.
# 中文：22b) 資料抓取的 SSRF 防護逃生開關。
#       預設情況下，POST /api/sources 會拒絕「主機名解析到私有網段 / loopback /
#       link-local / 多播 / 保留 IP」的網址——這就是 SSRF 防護，避免有人（或攻擊者）
#       把 feed 指向 http://169.254.169.254/（雲端 metadata）、
#       http://127.0.0.1:8000/admin、或只在內網的服務。
#       只有在「你刻意要從 localhost 抓資料」的可信本機開發環境，才設成 1。
#       正式環境「絕對不要」開啟。
ALPHA_ALLOW_LOCAL_INGEST=0

# --- 22c) Trading terminal hard safety caps -----------------------------
# All three caps apply to BOTH paper and live mode. They are independent
# of TRADING_TERMINAL_FAT_FINGER_PCT — fat-finger checks price drift,
# these check notional size and quote drift. Set to 0 to disable an
# individual cap (NOT recommended; the order would then proceed with no
# size ceiling).
# 中文：22c) 交易終端機的硬性安全上限。
#       下面三個上限對「紙上」和「實盤」模式都生效。它們和 fat-finger 是獨立的：
#       fat-finger 檢查「價格偏移」，這三個檢查「名目金額」與「報價漂移」。
#       設 0 可關閉個別上限（不建議；那筆單就會在沒有規模天花板的情況下放行）。

# Maximum order notional in USDT. A single order whose qty * mark_price
# exceeds this cap is rejected by validate_order before either paper or
# live submission. Default 50,000 USDT — comfortably above any sane
# single fill yet small enough that one fat-fingered keystroke cannot
# drain an account. Raise if you genuinely place six-figure orders.
# 中文：單筆下單名目金額上限（USDT）。當 qty × mark_price 超過此上限，validate_order
#       會在送出前（不論紙上或實盤）直接拒絕。預設 50000——足夠正常單，又小到
#       一次手殘按錯不會掏空帳戶。你真的會下六位數的單才調高。
TRADING_MAX_ORDER_NOTIONAL_USDT=50000.0

# New name for fat-finger price-drift cap. Identical semantics to
# TRADING_TERMINAL_FAT_FINGER_PCT (section 18) — kept under both names
# so the trading-risk knobs cluster together. The two env vars share
# state: whichever is non-empty wins; if both are set, this one
# (TRADING_FAT_FINGER_PCT) overrides the legacy name.
# 中文：fat-finger 價格偏移上限的「新名字」，語意和第 18 區的
#       TRADING_TERMINAL_FAT_FINGER_PCT 完全相同——保留兩個名字是為了讓交易風險
#       旋鈕集中在一起。兩個變數共用狀態：非空者生效；若兩個都設了，這個新名字
#       (TRADING_FAT_FINGER_PCT) 會覆蓋舊名字。
TRADING_FAT_FINGER_PCT=0.03

# Max permitted drift between a market order's quoted price (when the
# client supplies a `quote_price` field in the order payload) and the
# current mark. If the operator previewed the order at $30,000 and the
# market moved 1% before they hit submit, the order is rejected. Default
# 0.005 (0.5%) — tighter than fat-finger because this is a per-submit
# freshness check, not a per-price-magnitude check. Set to 0 to disable
# the drift check (NOT recommended for LIVE mode).
# 中文：市價單「報價漂移」的上限。當下單時帶了 quote_price 欄位，若市場價格從你
#       預覽當下（例如 $30,000）漂移超過這個比例你才按送出，這筆單就會被拒絕。
#       預設 0.005（0.5%），比 fat-finger 更嚴，因為這是「每次送出的新鮮度檢查」，
#       不是「價格幅度檢查」。設 0 可關閉漂移檢查（LIVE 模式不建議關）。
TRADING_MAX_QUOTE_DRIFT_PCT=0.005

# --- 22d) Rate-limit IP resolution behind a trusted reverse proxy -------
# When the FastAPI process sits behind a trusted reverse proxy / load
# balancer that injects X-Forwarded-For (nginx, Traefik, AWS ALB, etc.),
# set this to 1/true/yes so the /api/intake per-IP rate limiter keys on
# the *real* client IP rather than the proxy's IP (which would lump every
# request into a single bucket and trigger 429s for legitimate users).
# Leave OFF (default) when the API is reachable directly — otherwise an
# attacker can forge X-Forwarded-For headers to bypass the limit.
# 中文：22d) 在可信反向代理後方時，限流要怎麼判斷來源 IP。
#       當 FastAPI 跑在可信的反向代理 / 負載平衡器後面（nginx、Traefik、AWS ALB
#       等會塞 X-Forwarded-For 標頭）時，設成 1，讓 /api/intake 的每 IP 限流以
#       「真實 client IP」為準，而不是代理的 IP（否則所有請求會被算成同一個來源，
#       連正常使用者都被擋成 429）。
#       當 API 是「直接對外」時，請保持 0（預設）——否則攻擊者可偽造
#       X-Forwarded-For 標頭來繞過限流。
BEHIND_TRUSTED_PROXY=0


# =====================================================================
# 21) Periodic task interval overrides (advanced)
# =====================================================================
# Each periodic task in backend/core/periodic_tasks.py has a sensible
# default cadence. Override only when you have a specific reason
# (e.g. running on slow infra and want longer intervals). Values in
# seconds, clamped to >=10.
# 中文：第 21 區｜週期任務間隔覆蓋（進階）。
#       backend/core/periodic_tasks.py 裡的每個週期任務都有合理的預設頻率。
#       只有在你有特定理由時才覆蓋（例如跑在很慢的機器上、想拉長間隔）。
#       單位為秒，最小 10（小於 10 會被自動拉到 10）。
#       保持下面這些行被 # 註解掉，就是使用各自的預設值。
# 中文：紙上交易 tick 間隔（秒）。
# PERIODIC_PAPER_TRADE_TICK_SECONDS=30
# 中文：Telegram 每 6 小時脈動報告間隔（秒）。
# PERIODIC_TELEGRAM_SIX_HOUR_SECONDS=21600
# 中文：Telegram 早報間隔（秒，預設一天）。
# PERIODIC_TELEGRAM_MORNING_SECONDS=86400
# 中文：Telegram 紙上交易健康摘要間隔（秒）。
# PERIODIC_TELEGRAM_PAPER_HEALTH_SECONDS=3600
# 中文：知識庫重新連結(kb_relink)間隔（秒，預設半天）。
# PERIODIC_KB_RELINK_SECONDS=43200
# 中文：IC 衰減間隔（秒，預設一天）。
# PERIODIC_IC_DECAY_SECONDS=86400
# 中文：Granger 因果重算間隔（秒，預設一週）。
# PERIODIC_GRANGER_RECOMPUTE_SECONDS=604800
# 中文：IC 優先佇列 tick 間隔（秒）。
# PERIODIC_ALPHA_QUEUE_TICK_SECONDS=3600

# =====================================================================
# Real market-data ingestion (Binance public)  ·  P-REALDATA
# 真實市場資料抓取（Binance 公開資料，免 API key、免地區限制）
# =====================================================================
# English: All values below are OPTIONAL — backend/core/market_data.py ships
#   correct defaults. Trigger an ingest via `python -m backend.core.market_data`
#   or `POST /api/market-data/ingest`. It overwrites the on-disk price CSVs with
#   REAL OHLCV (+ funding & open-interest for BTC) in the existing schema, so
#   backtest / cointegration / factor pipelines run on real data unchanged.
# 中文：以下皆為選填（模組已內建正確預設）。用 CLI 或 POST /api/market-data/ingest
#   觸發；會把磁碟上的價格 CSV 覆寫成真實 OHLCV（BTC 另含資金費率與未平倉量），
#   沿用既有欄位格式，回測／協整／因子管線直接吃真資料。
#
# English: Public Binance data CDN host (geo-unrestricted, no key).
# 中文：Binance 公開資料 CDN 主機（免地區限制、免金鑰）。
# MARKET_DATA_BASE_URL=https://data.binance.vision
#
# English: Comma-separated app tickers to ingest. Empty = built-in 30-symbol
#   universe. BTC-USDT is always written as the 9-column primary
#   (OHLCV + open_interest + funding_rate + liquidations).
# 中文：要抓取的標的（逗號分隔）。留空＝內建 30 檔宇宙；BTC 一律寫成 9 欄主檔。
# MARKET_DATA_SYMBOLS=
#
# English: UTC start date (YYYY-MM-DD); end defaults to yesterday UTC.
# 中文：歷史抓取起始日（UTC, YYYY-MM-DD）；結束日預設昨天。
# MARKET_DATA_START=2024-01-01
#
# English: Parallel download workers (1..32).
# 中文：下載並行數（1..32）。
# MARKET_DATA_MAX_WORKERS=8
#
# English: Data source — "binance_public" (default; has funding + open interest)
#   or "yahoo" (yfinance; OHLCV only, ~730d of hourly history, but can fetch
#   equities/indices/FX/commodities that Binance has no symbol for).
# 中文：資料來源——binance_public（預設，含資金費率與未平倉量）或 yahoo
#   （yfinance，只有 OHLCV、小時線約 730 天，但能抓 Binance 沒有的股票/指數/匯率/商品）。
# MARKET_DATA_PROVIDER=binance_public
#
# English: Hourly incremental auto-refresh as a background task, which ALSO
#   advances every active forward-sim account over the freshly-landed bars
#   (otherwise the sim curves only move on a manual POST /api/market-data/ingest
#   and drift a day behind their own data). Default ON — the feed is free
#   (Binance public / Yahoo), only network egress. Set 0 to disable entirely.
#   Cadence override: PERIODIC_MARKET_DATA_REFRESH_SECONDS (default 3600 = 1h).
# 中文：每小時自動增量更新（背景任務），並同時推進所有 active 的 forward-sim
#   帳戶（吃掉剛落地的新 bar）；否則 sim 曲線只在手動打 POST /api/market-data/ingest
#   時才前進，會落後自己資料一天。預設開啟——資料源免費（Binance public / Yahoo），
#   僅網路流量。設 0 完全關閉。間隔覆寫：PERIODIC_MARKET_DATA_REFRESH_SECONDS（預設 3600 秒＝1 小時）。
# MARKET_DATA_REFRESH_ENABLED=1
# PERIODIC_MARKET_DATA_REFRESH_SECONDS=3600
#
# English: Auto-download a pair on demand when a strategy/factor needs a symbol
#   whose CSV is not on disk yet. Default ON; set 0 to disable.
# 中文：當策略/因子需要尚未下載的交易對時，自動下載其真實資料。預設開；設 0 關閉。
# MARKET_DATA_AUTO_FETCH=1
#
# NOTE / 注意: liquidations are NOT available from the free Binance source and
#   are written as 0.0. A faithful liquidation series needs a paid feed
#   (Coinglass / Amberdata / Kaiko); that adapter can be added later.
#   爆倉量(liquidations)免費端沒有，一律寫 0.0；需要真實爆倉資料要接付費源。

# ========================================================================
# 28) Strategy universe (P-MULTISYM) — which instruments proposals target
# ========================================================================
# English: The autonomous pipeline assigns each new strategy a target
#   instrument. By default it spans BOTH crypto bases AND US equities, instead
#   of only BTC. Equities are fetched on demand from Yahoo (yfinance) at 1h and
#   ride the same continuous hourly grid as crypto (overnight/weekend bars are
#   flat-filled) so the engine's sqrt(8760) annualization stays valid.
# 中文：自動管線會為每個新策略指派一個交易標的。預設同時涵蓋「加密貨幣 + 美股」，
#   而非只有 BTC。股票按需從 Yahoo（yfinance）抓小時線，並走與加密貨幣相同的
#   連續每小時 grid（盤後/週末以前值填補），讓引擎的 sqrt(8760) 年化維持正確。
#
# English: Master kill-switch. 0 = revert to the original BTC-only behavior.
# 中文：總開關。設 0 = 完全回到原本只跑 BTC 的行為。
# STRATEGY_MULTI_SYMBOL_ENABLED=1
#
# English: Universe scope — "crypto" | "equity" | "mixed" (default mixed).
# 中文：宇宙範圍——crypto｜equity｜mixed（預設 mixed）。
# STRATEGY_UNIVERSE_MODE=mixed
#
# English: Per-strategy pick — "rotate" (deterministic round-robin, classes
#   interleaved) | "random" (uniform). Default rotate.
# 中文：每個策略的挑選方式——rotate（決定性輪詢，兩類交錯）｜random（均勻隨機）。預設 rotate。
# STRATEGY_SYMBOL_SELECTION=rotate
#
# English: Override the crypto bases (CSV). Empty = the built-in 30 (BTC first).
# 中文：覆寫加密貨幣標的（逗號分隔）。留空＝內建 30 檔（BTC 優先）。
# STRATEGY_CRYPTO_SYMBOLS=
#
# English: Override the equity tickers (CSV). Empty = AAPL,MSFT,NVDA,AMZN,GOOGL,
#   META,TSLA,AMD,NFLX,JPM,SPY,QQQ. Use bare Yahoo tickers (e.g. AAPL, ^GSPC).
# 中文：覆寫股票標的（逗號分隔）。留空＝上列 12 檔；使用 Yahoo 原生代號（如 AAPL、^GSPC）。
# STRATEGY_EQUITY_SYMBOLS=
#
# English: Re-fetch a cached equity CSV older than N days (0 = never on staleness).
# 中文：快取股票 CSV 超過 N 天就重抓（0 ＝不因過期重抓）。
# EQUITY_DATA_MAX_AGE_DAYS=3

# ========================================================================
# 29) Strategy quality gates (P-GATES) — deterministic floors + dead-cull
# ========================================================================
# English: Two LLM-independent checks layered onto the pipeline. (1) A pre-critic
#   liveness gate rejects dead backtests (0 trades) and SKIPS the expensive Critic
#   call. (2) A post-critic quality gate computes statistical-honesty floors
#   (Probabilistic Sharpe / Sortino / min-trades) + a short-vol red flag from the
#   additive risk metrics (Sortino-TDD, PSR, ρ₁-adjusted Sharpe, skew). These are
#   purely additive — the engine and every already-produced strategy are untouched.
# 中文：兩道與 LLM 無關的檢查。(1) critic 前的「活著嗎」閘門:死回測(0 筆交易)直接淘汰並
#   跳過昂貴的 critic 呼叫。(2) critic 後的品質閘門:用附加風險指標(Sortino-TDD、PSR、
#   ρ₁ 修正 Sharpe、偏態)算出統計誠實度底線(PSR/Sortino/最少交易)＋賣波動率紅旗。純 additive,
#   不動引擎、不動任何已產出的策略。
#
# --- Pre-critic liveness gate ---
# English: Skip Critic + reject 0-trade backtests. Default ON (only trips on dead runs).
# 中文：跳過 critic 並淘汰 0 筆交易的死回測。預設開(只對死回測生效)。
# STRATEGY_PRECRITIC_GATE=1
# STRATEGY_PRECRITIC_MIN_TRADES=1
#
# --- Post-critic quality gate ---
# English: ENFORCE=0 (default) = OBSERVE mode: vetoes are recorded on the strategy
#   for telemetry but the verdict is UNCHANGED (approval rate stays the same). Set 1
#   to let the deterministic floors veto an LLM "Go". Inspect the recorded
#   `quality_gate` field on a batch of strategies BEFORE enforcing.
# 中文：ENFORCE=0(預設)＝觀測模式:否決原因會記在策略上供觀察,但不改判決(核准率不變)。
#   設 1 才讓確定性底線否決 LLM 的 "Go"。建議先看一批策略記錄的 `quality_gate` 欄位再決定是否 enforce。
# STRATEGY_GATE_ENFORCE=0
# STRATEGY_GATE_MIN_TRADES=20
# English: Probabilistic Sharpe Ratio floor (0..1, 0=off). 0.90 ≈ "track record is
#   statistically distinguishable from luck given skew/kurtosis/length".
# 中文：機率夏普比率底線(0..1,0=關)。0.90 ≈「考慮偏態/峰度/樣本長度後,績效在統計上不像運氣」。
# STRATEGY_GATE_MIN_PSR=0.90
# English: Annualized Sortino floor (0=off). Rewards positive-skew/trend strategies
#   that Sharpe systematically underrates.
# 中文：年化 Sortino 底線(0=關)。獎勵被 Sharpe 系統性低估的正偏態/趨勢策略。
# STRATEGY_GATE_MIN_SORTINO=0
# English: Deflated Sharpe Ratio floor (0..1, 0=off). DSR corrects the PSR for
#   MULTIPLE-TESTING selection bias across the factory's many trials (Bailey-LdP
#   2014): a high Sharpe that can't beat the best-of-N-under-the-null scores low.
#   Attached only once enough prior trials exist (see STRATEGY_DSR_* in §30);
#   absent ⇒ never vetoes.
# 中文：Deflated Sharpe 底線(0..1,0=關)。對策略工廠大量試驗做「多重檢定」選擇偏差校正
#   (Bailey-LdP 2014):贏不過 N 次試驗期望最大值的高 Sharpe 在此分數低。需累積足夠歷史試驗才附上
#   (見 §30 的 STRATEGY_DSR_*);缺值＝不否決。
# STRATEGY_GATE_MIN_DSR=0
# English: Calmar ratio floor (annualized return / |max drawdown|, 0=off). Vetoes
#   strategies whose return is small relative to their worst peak-to-trough loss.
# 中文：Calmar 比率底線(年化報酬 / |最大回撤|,0=關)。否決報酬相對最糟回撤過小的策略。
# STRATEGY_GATE_MIN_CALMAR=0
# English: Short-vol red FLAG (advisory, never vetoes): Sharpe > X AND skew < Y.
# 中文：賣波動率紅旗(僅標記,不否決):Sharpe > X 且 偏態 < Y。
# STRATEGY_GATE_SHORTVOL_SHARPE=2.0
# STRATEGY_GATE_SHORTVOL_SKEW=-1.0

# ========================================================================
# 30) Pipeline optimizations — model routing, cost cap, diversity, OOS,
#     learning loop, concurrency (all additive; safe defaults)
# ========================================================================
#
# --- A2) Per-agent model routing (cost) ---
# English: Point cheap/mechanical agents at a small model and keep the
#   reasoning-heavy Critic on the strong one. Empty ⇒ provider default (current
#   behavior). Use a model id VALID FOR YOUR PROVIDER (e.g. an OpenRouter id).
#   This sets only the model NAME — it never touches OPENROUTER_API_KEY.
# 中文：把便宜/機械式的 agent 指到小模型,推理重的 Critic 留在強模型。留空＝provider 預設。
#   值必須是你的 provider 認得的 model id(如 OpenRouter 的);只設模型「名稱」,不碰 API key。
#   Recommended cost tiering (verify the ids against YOUR provider's catalog):
#     • Anthropic native :  INTAKE/CODER → claude-haiku-4-5 ; keep RESEARCHER →
#                           claude-sonnet-4-6 , CRITIC → claude-sonnet-4-6
#     • OpenRouter       :  INTAKE/CODER → anthropic/claude-haiku-4.5 ; keep
#                           RESEARCHER/CRITIC → anthropic/claude-sonnet-4.6
#   Intake is mechanical (text→node) and the highest-volume caller — the safest,
#   biggest cost win. CODER→haiku is optional: watch the coder format-retry rate
#   (coder.failed) after switching. Keep the Critic's risk verdict on the strong
#   model. Empty (below) ⇒ provider default for every agent (today's behavior).
# LLM_MODEL_INTAKE=
# LLM_MODEL_RESEARCHER=
# LLM_MODEL_CODER=
# LLM_MODEL_CRITIC=
#
# --- FinOps) Per-strategy USD ceiling ---
# English: Hard cap on a SINGLE strategy's LLM spend (independent of the daily
#   cap). A runaway strategy (deep retries / huge prompts) trips this and is
#   REJECTED instead of eating the whole daily budget. 0 = off (default).
# 中文：單一策略的 LLM 花費硬上限(獨立於每日上限)。失控策略(深度重試/超大 prompt)會撞此上限
#   並被淘汰,而非吃光整日預算。0＝關(預設)。
# ALPHA_LLM_PER_STRATEGY_USD_CAP=0
#
# --- C1) Diversity gate (favor decorrelated alphas) ---
# English: Flags/vetoes a candidate whose daily-return correlation with the
#   approved pool exceeds the threshold (QFLM: a book of decorrelated alphas
#   beats N clones of the best one). OBSERVE by default (records max_correlation
#   on the strategy without blocking); set GATE=1 to enforce.
# 中文：當候選策略與已核准池的日報酬相關性超過門檻時,標記/否決(QFLM:一籃子去相關的 alpha
#   勝過 N 個最強策略的克隆)。預設觀測(只記錄 max_correlation,不擋);設 GATE=1 才強制。
# STRATEGY_DIVERSITY_GATE=0
# STRATEGY_DIVERSITY_MAX_CORR=0.90
# STRATEGY_DIVERSITY_POOL_SIZE=30
# STRATEGY_DIVERSITY_MIN_OVERLAP=20
#
# --- C2) Out-of-sample (walk-forward-lite) metrics ---
# English: Re-backtest each strategy on the last fraction of bars it was never
#   chosen on, and attach oos_* metrics (a big in-sample/out-of-sample gap flags
#   overfitting). 0 disables. Default 0.30. Purely additive telemetry; the
#   primary full-series metrics are unchanged.
# 中文：用「從未用來挑因子」的尾段 bar 重跑回測,附加 oos_* 指標(IS/OOS 落差大＝過擬合警訊)。
#   0＝關;預設 0.30。純附加遙測,主回測(全段)指標不變。
# STRATEGY_OOS_FRACTION=0.30
#
# --- C2b) Deflated Sharpe Ratio (multiple-testing correction) ---
# English: Attach the Deflated Sharpe Ratio (Bailey-LdP 2014) to each backtest:
#   PSR but with the benchmark raised from 0 to the expected MAXIMUM Sharpe across
#   the factory's prior trials, so a Sharpe that's just the luckiest of many
#   candidates scores low. Computed only once >= MIN_TRIALS prior strategies exist
#   (else the plain PSR stands). Gate it via STRATEGY_GATE_MIN_DSR (§29). Additive
#   telemetry; ENABLED=0 skips the trial-Sharpe DB read entirely.
# 中文：對每次回測附上 Deflated Sharpe(Bailey-LdP 2014):把 PSR 基準從 0 抬到工廠歷史試驗的
#   「期望最大 Sharpe」,於是「眾多候選裡最好運那支」的高 Sharpe 在此分數低。需 >= MIN_TRIALS 支
#   歷史策略才計(否則沿用一般 PSR)。用 STRATEGY_GATE_MIN_DSR(§29)設閘。ENABLED=0 完全跳過。
# STRATEGY_DSR_ENABLED=1
# STRATEGY_DSR_MIN_TRIALS=20               # min prior strategies before deflating
# STRATEGY_DSR_MAX_TRIALS=1000             # cap on the trial-Sharpe DB read
#
# --- C3) Learning loop (close the feedback loop) ---
# English: Inject the K most-recent REJECTED attempts into the Researcher's
#   prompt so each new story aims for a genuinely different edge (QFLM
#   '站在上一輪肩膀上'). Default ON, bounded. Set =0 to disable.
# 中文：把最近 K 個被否決的嘗試注入 Researcher 的 prompt,讓每支新故事瞄準真正不同的切角
#   (QFLM「站在上一輪肩膀上」)。預設開、有上限;設 0 關閉。
# RESEARCHER_LEARN_FROM_FAILURES=1
# RESEARCHER_FAILURE_CONTEXT_K=5
#
# --- B) Pipeline concurrency (throughput) ---
# English: Strategies processed in parallel. NOW RESIZABLE AT RUNTIME (no restart
#   needed). Default 1 (single-flight). Raise ONLY with your LLM provider's rate
#   limits AND the daily/per-strategy budget caps in mind — parallelism
#   multiplies both throughput and spend. Pair with the quality gates above.
# 中文：並行處理的策略數。現在可在執行期間動態調整(免重啟)。預設 1(單線)。調高前務必考量
#   provider 的限流與每日/每策略預算上限——並行會同時放大吞吐與花費;建議搭配上面的品質閘門。
# AUTO_PIPELINE_CONCURRENCY=1

# ===========================================================================
# §31 — Pipeline optimization blueprint (T1-A…T3-A). Shipped additive +
#       OBSERVE/OFF-default: with every knob below UNSET, behaviour is
#       byte-identical to before. Flip enforcement only after inspecting the
#       recorded telemetry. Full design: memory/pipeline-quality-gates.md.
# ===========================================================================

# --- T1-A) Blind / anti-confirmation-bias Critic ---
# EN: A first mechanical critic pass sees ONLY code + raw metrics (no story), so
#   a persuasive narrative can't rescue a statistically weak strategy. OBSERVE
#   records blind agreement; ENFORCE lets a blind No-Go veto a story-aware Go.
#   Costs +1 small LLM call per critic when ON.
# 中文：盲評先只看程式碼+數據(不看故事),避免漂亮敘事救回統計上很弱的策略。OBSERVE 只記錄;
#   ENFORCE 讓盲評的 No-Go 否決故事版的 Go。開啟時每次 critic 多 1 次小型 LLM 呼叫。
# CRITIC_BLIND_PASS=0
# CRITIC_BLIND_ENFORCE=0
# CRITIC_BLIND_MAX_TOKENS=700

# --- T1-C) Coder format-failure retry (ACTIVE: cheap reliability win) ---
# EN: Re-prompt the coder with the parse/AST error BEFORE backtest, up to N extra
#   times. 0 = old behaviour (raise on first malformed output). 1 covers the
#   common transient format slip at ≤+2 calls/strategy worst case. Clamp [0,3].
# 中文：coder 輸出解析/AST 失敗時,帶著錯誤就地重提(回測前),最多 N 次。0=舊行為;1 可吸收
#   常見的暫時性格式失誤。上限 [0,3]。
CODER_FORMAT_RETRY_MAX=1

# --- T1-D) Regime / sub-period stability gate (OBSERVE-default) ---
# EN: Slices the backtest into N sub-periods; flags a Sharpe propped by one lucky
#   window. ENFORCE vetoes regime-fragile strategies. Insufficient data never
#   vetoes. Defaults pass a normal multi-window strategy even when enforced.
# 中文：把回測切 N 段,抓出只靠單一幸運窗撐起的 Sharpe。ENFORCE 否決 regime 脆弱者;資料不足
#   一律放行。預設值即使 enforce 也讓正常多窗策略通過。
# STRATEGY_REGIME_GATE=0
# STRATEGY_REGIME_WINDOWS=6
# STRATEGY_REGIME_MIN_POSITIVE_FRAC=0.50
# STRATEGY_REGIME_MIN_WORST_SHARPE=-1.0
# STRATEGY_REGIME_MAX_DISPERSION=0.0

# --- T3-B) Pre-critic Score Card (default ON; superset of the liveness gate) ---
# EN: Cheaply rejects junk (non-finite core metrics, over-trading, constant
#   returns, 0 evaluable regime windows) BEFORE the Critic LLM call — all cases
#   the Critic would hard-fail anyway. Set 0 to collapse back to the bare
#   0-trade liveness check.
# 中文：在 critic 之前用零成本的確定性檢查剔除垃圾(非有限指標、過度交易、常數報酬、0 regime
#   窗),這些 critic 本來也會硬否決。設 0 退回純 0-trade liveness。
# STRATEGY_SCORECARD_GATE=1
# STRATEGY_SCORECARD_MAX_TRADES=50000

# --- T1-B) Summary-first knowledge memory ---
# EN: Each KB node carries a short agent-facing summary; the Researcher loads
#   summaries first and expands FULL content only for the top-K highest-IC nodes
#   within a char budget (cuts tokens + lost-in-the-middle). Extractive, no LLM.
# 中文:每個 KB 節點帶一段給 agent 看的短摘要;researcher 先載摘要,只對 IC 最高的前 K 個節點
#   在字元預算內展開全文(省 token + 避免迷失中段)。萃取式,不花 LLM。
# KB_SUMMARY_MAX_CHARS=360
# KB_SUMMARY_LAZY_BACKFILL=1
# RESEARCHER_EXPAND_TOP_K=3
# RESEARCHER_CONTEXT_CHAR_BUDGET=24000

# --- T2-B) Confidence-decay → revisit loop (OFF-default) ---
# EN: A past_alpha/postmortem whose live/OOS outcome is poor loses confidence and
#   is flagged status='revisit' so the Researcher treats it as suspect; a good
#   outcome rewards confidence and clears the latch. Independent of IC decay.
# 中文：live/OOS 表現差的 past_alpha/postmortem 會降低 confidence 並標記 revisit,讓
#   researcher 視為可疑;表現好則回補並解除標記。與 IC 衰減獨立。
# KB_CONFIDENCE_DECAY_ENABLED=0
# KB_CONF_DECAY_FACTOR=0.7
# KB_CONF_REWARD=0.1
# KB_CONF_FLOOR=0.05
# KB_CONF_REVISIT_THRESHOLD=0.25
# KB_CONF_BAD_IC=0.0
# KB_CONF_GOOD_IC=0.02
# RESEARCHER_REVISIT_K=3
# RESEARCHER_SURFACE_REVISIT=1

# --- T2-A / T2-C) Knowledge-graph intelligence (seeding OFF-default) ---
# EN: Bridge nodes (high betweenness) connect disconnected concept clusters =
#   novel cross-domain hypotheses; GRAPH_RAG_SEED_SELECTION=1 augments the auto-
#   pipeline seed with up to N of them (identity fallback when empty). Vital
#   signs (diversity_index/gap_pressure/orphans/bridges) feed the Mission Control
#   rail via /api/knowledge/stats (also the TRUE node count, un-capped). LLM-free.
# 中文：bridge 節點(高介數)連接互不相連的概念叢集=跨域新假設;GRAPH_RAG_SEED_SELECTION=1
#   會把最多 N 個餵進自動管線選題(空圖時退回原選題)。vital signs 經 /api/knowledge/stats
#   餵給儀表板(也提供未截斷的真實節點數)。全程不花 LLM。
# GRAPH_RAG_SEED_SELECTION=0
# GRAPH_RAG_SEED_MAX_EXTRA=3
# GRAPH_INTEL_BRIDGE_TOP_N=50
# GRAPH_INTEL_BRIDGE_BETWEENNESS_MIN=0.01
# GRAPH_INTEL_GAP_MIN_CONCEPTS=3
# GRAPH_INTEL_GAP_PRESSURE_MIN=4.0
# GRAPH_INTEL_EXACT_BC_MAX=4000
# GRAPH_INTEL_BC_SAMPLE_K=500
# GRAPH_INTEL_BC_SEED=1337

# --- T3-A) Evolutionary hypothesis-tree search (OFF-default) ---
# EN: Instead of always proposing fresh, MUTATE/SPECIALISE the best surviving
#   strategies (approved pool, ranked by realised OOS Sharpe) so generation
#   compounds. EVOLUTION_FRACTION is a re-allocation dial (NOT extra spend — the
#   daily/per-strategy caps still bound total cost). Children flow through the
#   SAME pipeline + gates; lineage is stamped in config_json. Cold-start safe.
# 中文：不再每次都全新提案,而是把存活最佳策略(approved 池,依實現 OOS Sharpe 排序)做
#   突變/特化,讓品質複利。EVOLUTION_FRACTION 是「重新分配」旋鈕(非額外花費,每日/每策略上限
#   仍封頂)。子代走同一條管線+閘門;血緣記在 config_json。空池自動退回新提案。
# EVOLUTION_ENABLED=0
# EVOLUTION_FRACTION=0.0
# EVOLUTION_PARENT_POOL_SIZE=20
# EVOLUTION_MIN_PARENT_OOS_SHARPE=0.5
# EVOLUTION_MAX_DEPTH=4
# EVOLUTION_OP_MAX_TOKENS=2400
# EVOLUTION_OPERATOR=mutate

# --- T2-D) Cascading model routing (pure config; leave blank = all minimax) ---
# EN: Route cheap/classification stages to a small model, keep reasoning-heavy
#   stages on the strong default. Blank ⇒ OPENROUTER_MODEL for every agent
#   (today's behaviour). Only assign JSON-mode-capable models to INTAKE/CRITIC.
# 中文：把便宜/分類階段路由到小模型,推理重的留強模型。留空=全部用 OPENROUTER_MODEL(現狀)。
#   INTAKE/CRITIC 只能指派支援 JSON 模式的模型。
# LLM_MODEL_INTAKE=
# LLM_MODEL_RESEARCHER=
# LLM_MODEL_CODER=
# LLM_MODEL_CRITIC=

# ─────────────────────────────────────────────────────────────────────────────
# §32 — Round-3 optimizations (T-REVISE / T-BOOTSTRAP / T-FINOPS + critic routing)
#   Additive. observe/off-default unless noted. Restart to load.
# ─────────────────────────────────────────────────────────────────────────────
#
# T-REVISE — critic-feedback STORY revision. On a No-Go, revise the alpha story
# (not just re-run the coder) from the critic's objections before the one
# existing retry. Off ⇒ byte-identical legacy coder-only retry. One extra
# researcher call per revised attempt, charged to the per-strategy budget cap.
# CRITIC_REVISE_STORY=0
#
# T-BOOTSTRAP — moving-block bootstrap of the backtest Sharpe (CI + P(Sharpe>0)),
# attached additively to every backtest's metrics. Pure/deterministic; no LLM.
# STRATEGY_BOOTSTRAP_ENABLED=1            # 0 disables the computation
# STRATEGY_BOOTSTRAP_N=1000               # resamples (clamped 100..20000)
# STRATEGY_GATE_MIN_BOOTSTRAP_PROB=0.0    # observe floor on P(Sharpe>0); 0=off.
#                                         # >0 AND STRATEGY_GATE_ENFORCE=1 vetoes.
#
# T-FINOPS — per-call LLM cost ledger (append-only). Powers /api/cost/summary +
# the KpiRail "LLM Cost 7d" tile. Default ON; pruned daily by retention sweep.
# Records OpenRouter's REAL billed cost+tokens (usage.include) when available,
# else a flat-pricing char estimate (the cost_source column marks which).
# LLM_COST_LEDGER_ENABLED=1
# LLM_COST_LEDGER_RETENTION_DAYS=90       # cost_ledger_prune horizon (1..3650)
# OPENROUTER_USAGE_ACCOUNTING=1           # 0 ⇒ skip usage.include, char-estimate only
#
# P-CACHE — mark the (stable) per-agent system prompt as an Anthropic prompt-cache
# breakpoint so repeat calls within the ~5-min TTL re-read it at ~0.1x input cost
# instead of full price. The factory reuses the same system prompt across every
# strategy, critic-revise retry and evolution child, so the hit rate is high.
# Works on the native Anthropic SDK and on OpenRouter for Claude models (plain
# string kept for non-Claude). Default ON; below a model's min cacheable prefix
# (~2048 tok Sonnet-4.6 / ~4096 Opus-Haiku-4.5) it silently no-ops.
# LLM_PROMPT_CACHE=1                       # 0 ⇒ legacy uncached system-string path
#
# Per-agent model routing (infra in §30). Route the highest-stakes agent (Critic)
# to a stronger model; keep researcher/coder on the cheap default.
# LLM_MODEL_CRITIC=anthropic/claude-sonnet-4.6
